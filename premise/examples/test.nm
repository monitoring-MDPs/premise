pomdp

const n; 

const l1s; const l1d;
const l2s; const l2d;
const l3s; const l3d;
const l4s; const l4d;

const s1s; const s1d;

formula ladder = pos = l1s | pos = l2s | pos = l3s | pos = l4s;
formula snake  = pos = s1s;

const d = 6;

module main
    pos : [0..n] init 0;

    [] pos = l1s -> 1:(pos' = l1d);
    [] pos = l2s -> 1:(pos' = l2d);
    [] pos = l3s -> 1:(pos' = l3d);
    [] pos = l4s -> 1:(pos' = l4d);
    [] pos = s1s -> 1:(pos' = s1d);

    [] pos = n -> 1:(pos' = n);

    [] !ladder & !snake & pos != n ->
        1/d : (pos' = (pos + 1 > n ? 2*n - (pos + 1) : pos + 1)) +
        1/d : (pos' = (pos + 2 > n ? 2*n - (pos + 2) : pos + 2)) +
        1/d : (pos' = (pos + 3 > n ? 2*n - (pos + 3) : pos + 3)) +
        1/d : (pos' = (pos + 4 > n ? 2*n - (pos + 4) : pos + 4)) +
        1/d : (pos' = (pos + 5 > n ? 2*n - (pos + 5) : pos + 5)) +
        1/d : (pos' = (pos + 6 > n ? 2*n - (pos + 6) : pos + 6));
endmodule

label "ladder" = ladder;
label "snake"  = snake;
label "normal" = !ladder & !snake & pos > 0;
label "good"   = pos = n;

observable "ladder" = ladder;
observable "snake"  = snake;
observable "normal" = !ladder & !snake & pos > 0;
