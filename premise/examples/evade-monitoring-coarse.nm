pomdp

observables
start, ax, ay, turn
endobservables

const int RADIUS;

const int N;

const int coarse = 2;

const int xMAX = N-1;
const int yMAX = N-1;
const int aXMAX = xMAX;
const int aYMAX = yMAX;
const int aXMIN = 0;
const int aYMIN = 1;
const int dxMAX = xMAX;
const int dyMAX = yMAX;
const int dxMIN = 0;
const int dyMIN = 0;
const double slippery = 0.2;

const int caxMIN = floor(aXMIN/coarse);
const int cayMIN = floor(aYMIN/coarse);
const int caxMAX = floor(aXMAX/coarse);
const int cayMAX = floor(aYMAX/coarse);
const int cdxMIN = floor(dxMIN/coarse);
const int cdyMIN = floor(dyMIN/coarse);
const int cdxMAX = floor(dxMAX/coarse);
const int cdyMAX = floor(dyMAX/coarse);


formula done = ax = aXMIN & ay = aYMIN;
observable "done" = done;
formula crash =  (dx = ax & dy = ay);
observable "crash" = crash;
formula seedrone = ax-dx < RADIUS + 1 & dx-ax < RADIUS +1 & ay-dy < RADIUS+1 & dy -ay < RADIUS+1;
formula see_dx = seedrone ? dx : -1;
formula see_dy = seedrone ? dy : -1;
observable "see_dx" = see_dx;
observable "see_dy" = see_dy;

module master
    start : bool init false;
    turn : bool init false;

    [placement] !start -> (start'=true);
    [adv]  start & turn -> (turn'=!turn);
    [ego]  start & !turn -> (turn'=!turn);
endmodule

module ego
    ax : [aXMIN..aXMAX] init aXMAX-1;
    ay : [aYMIN..aYMAX] init aYMAX;
    c_ax : [caXMIN..caXMAX] init floor((aXMAX-1)/coarse);
    c_ay : [caYMIN..caYMAX] init caYMAX;

    [ego] true -> 1/4 : (ax'=max(ax-1,aXMIN))&(c_ax'=max(floor((ax-1)/coarse), caxMAX)) 
                + 1/4: (ax'=min(ax+1,aXMAX))&(c_ax'=min(floor((ax+1)/coarse), caxMAX)) 
                + 1/4 : (ay'=max(ay-1,aYMIN))&(c_ay'=max(floor((ay-1)/coarse), cayMAX))
                + 1/4 : (ay'=min(ay+1,aYMAX))&(c_ay'=min(floor((ay+1)/coarse), cayMAX));
    endmodule

module drone
    dx : [dxMIN..dxMAX] init 0;
    dy : [dyMIN..dyMAX] init 0;
    c_dx : [cdxMIN..cdxMAX] init 0;
    c_dy : [cdyMIN..cdyMAX] init 0;

    [adv] true -> (1-slippery): (dx'=max(dx-1,dxMIN))&(c_dx'=max(floor((dx-1)/coarse), cdxMIN)) 
                                + slippery: (dx'=max(dx,dxMIN));
    [adv] true -> (1-slippery): (dx'=min(dx+1,dxMAX)) + slippery: (dx'=min(dx,dxMAX));
    [adv]  true -> (1-slippery): (dy'=min(dy+1,dyMAX)) + slippery: (dy'=min(dy,dyMAX));
    [adv]  true -> (1-slippery): (dy'=max(dy-1,dyMIN)) + slippery: (dy'=max(dy,dyMIN));
endmodule

label "goal" = done;
label "crash" = crash;
label "notbad" =  !crash;
