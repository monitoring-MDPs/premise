pomdp

const n;

const l1s;
const l1d;
const l2s;
const l2d;
const l3s;
const l3d;
const l4s;
const l4d;
const l5s;
const l5d;
const l6s;
const l6d;
const l7s;
const l7d;
const l8d;
const l8s;
const l9s;
const l9d;
const l10s;
const l10d;

const s1s;
const s1d;
const s2s;
const s2d;
const s3s;
const s3d;
const s4s;
const s4d;
const s5s;
const s5d;
const s6s;
const s6d;
const s7s;
const s7d;
const s8d;
const s8s;
const s9s;
const s9d;
const s10s;
const s10d;


formula ladder = pos=l1s|pos=l2s|pos=l3s|pos=l4s|pos=l5s|pos=l6s|pos=l7s|pos=l8s|pos=l9s|pos=l10s;
formula snake = pos=s1s|pos=s2s|pos=s3s|pos=s4s|pos=s5s|pos=s6s|pos=s7s|pos=s8s|pos=s9s|pos=s10s;

const d = 6;
const dice_mod = 1/12 + 1/24;

module main
    pos : [0..n] init 0;

    [choose] true -> 1:(pos'=pos);

    [roll] pos=s1s -> 1:(pos'=s1d);
    [roll] pos=s2s -> 1:(pos'=s2d);
    [roll] pos=s3s -> 1:(pos'=s3d);
    [roll] pos=s4s -> 1:(pos'=s4d);
    [roll] pos=s5s -> 1:(pos'=s5d);
    [roll] pos=s6s -> 1:(pos'=s6d);
    [roll] pos=s7s -> 1:(pos'=s7d);
    [roll] pos=s8s -> 1:(pos'=s8d);
    [roll] pos=s9s -> 1:(pos'=s9d);
    [roll] pos=s10s -> 1:(pos'=s10d);

    [roll] pos=l1s -> 1:(pos'=l1d);
    [roll] pos=l2s -> 1:(pos'=l2d);
    [roll] pos=l3s -> 1:(pos'=l3d);
    [roll] pos=l4s -> 1:(pos'=l4d);
    [roll] pos=l5s -> 1:(pos'=l5d);
    [roll] pos=l6s -> 1:(pos'=l6d);
    [roll] pos=l7s -> 1:(pos'=l7d);
    [roll] pos=l8s -> 1:(pos'=l8d);
    [roll] pos=l9s -> 1:(pos'=l9d);
    [roll] pos=l10s -> 1:(pos'=l10d);

    [roll] pos=n -> 1:(pos'=n);
    [roll] !ladder & !snake & !(pos=n) & weight=0 -> 
                                    1/d+dice_mod:(pos'=(pos + 1 > n) ? (n - (n - (pos + 1))*-1) : (pos + 1)) +
                                    1/d+dice_mod:(pos'=(pos + 2 > n) ? (n - (n - (pos + 2))*-1) : (pos + 2)) +
                                    1/d+dice_mod:(pos'=(pos + 3 > n) ? (n - (n - (pos + 3))*-1) : (pos + 3)) +
                                    1/d-dice_mod:(pos'=(pos + 4 > n) ? (n - (n - (pos + 4))*-1) : (pos + 4)) +
                                    1/d-dice_mod:(pos'=(pos + 5 > n) ? (n - (n - (pos + 5))*-1) : (pos + 5)) +
                                    1/d-dice_mod:(pos'=(pos + 6 > n) ? (n - (n - (pos + 6))*-1) : (pos + 6));
    [roll] !ladder & !snake & !(pos=n) & weight=1 -> 
                                    1/d:(pos'=(pos + 1 > n) ? (n - (n - (pos + 1))*-1) : (pos + 1)) +
                                    1/d:(pos'=(pos + 2 > n) ? (n - (n - (pos + 2))*-1) : (pos + 2)) +
                                    1/d:(pos'=(pos + 3 > n) ? (n - (n - (pos + 3))*-1) : (pos + 3)) +
                                    1/d:(pos'=(pos + 4 > n) ? (n - (n - (pos + 4))*-1) : (pos + 4)) +
                                    1/d:(pos'=(pos + 5 > n) ? (n - (n - (pos + 5))*-1) : (pos + 5)) +
                                    1/d:(pos'=(pos + 6 > n) ? (n - (n - (pos + 6))*-1) : (pos + 6));
    [roll] !ladder & !snake & !(pos=n) & weight=2 -> 
                                    1/d-dice_mod:(pos'=(pos + 1 > n) ? (n - (n - (pos + 1))*-1) : (pos + 1)) +
                                    1/d-dice_mod:(pos'=(pos + 2 > n) ? (n - (n - (pos + 2))*-1) : (pos + 2)) +
                                    1/d-dice_mod:(pos'=(pos + 3 > n) ? (n - (n - (pos + 3))*-1) : (pos + 3)) +
                                    1/d+dice_mod:(pos'=(pos + 4 > n) ? (n - (n - (pos + 4))*-1) : (pos + 4)) +
                                    1/d+dice_mod:(pos'=(pos + 5 > n) ? (n - (n - (pos + 5))*-1) : (pos + 5)) +
                                    1/d+dice_mod:(pos'=(pos + 6 > n) ? (n - (n - (pos + 6))*-1) : (pos + 6));                                                                    
    
endmodule

module diceweight
    weight : [-1..2] init -1;

    [choose] weight=-1 -> 1/3:(weight'=0) + 1/3:(weight'=1) + 1/3:(weight'=2);
    [roll] weight>=0 -> (weight'=weight);
endmodule


label "ladder" = ladder;
label "snake" = snake;
label "normal" = !ladder & !snake & pos>0;

observable "ladder" = ladder;
observable "snake" = snake;
observable "normal" = !ladder & !snake & pos>0;

label "good" = pos=n;
