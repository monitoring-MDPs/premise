{
	"name": "Premise dev container",
	"image": "lukovdm/premise:interval",
	"runArgs": [
		"--net=host",
		"--gpus",
		"all",
		"--runtime=nvidia"
	],
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-python.black-formatter",
				"ms-toolsai.jupyter",
				"ms-toolsai.jupyter-keymap",
				"UCSCFormalMethods.Scenic",
				"Percy.vscode-pydata-viewer"
			]
		}
	}
}